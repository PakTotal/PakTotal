<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\PakTotal.Core\PakTotal.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ModuleProject Include="..\Modules\*\src\*.csproj;..\Modules.Private\*\src\*.csproj" />
        <ProjectReference Include="@(ModuleProject)" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    </ItemGroup>

</Project>
