{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "PakTotal": {
        "TempDirectory": "/tmp/paktotal",
        "ModulesDirectory": "modules",
        "NativeDirectory": "native",
        "DatabasePath": "data/paktotal.db",
        "MaxDatabaseBytes": 21474836480,
        "MappingsCacheEntries": 2,
        "MaxUploadBytes": 104857600,
        "MaxConcurrentBytes": 10737418240,
        "MaxQueueLength": 200,
        "ScanTimeout": "00:03:00",
        "ModuleTimeout": "00:01:00",
        "ResultRetention": "00:15:00",
        "SubmitPermitsPerMinute": 10,
        "ReadPermitsPerMinute": 120,
        "TrustedProxies": [],
        "TrustedNetworks": []
    }
}
