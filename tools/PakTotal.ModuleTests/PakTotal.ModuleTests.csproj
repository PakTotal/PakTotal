<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PakTotal.Core\PakTotal.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ModuleProject Include="..\..\Modules\*\src\*.csproj;..\..\Modules.Private\*\src\*.csproj" />
        <ProjectReference Include="@(ModuleProject)" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    </ItemGroup>

</Project>
